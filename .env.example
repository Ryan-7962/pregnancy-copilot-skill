# Do not commit real secrets.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# Default mode is Host Agent Mode: OpenClaw/Codex/Claude Code already provide the LLM.
# The optional commands below are only for standalone unattended event loops.

# Optional semantic triage hook for standalone mode.
# The command receives the triage prompt on stdin and must print JSON on stdout.
# Quote paths that contain spaces.
PREGNANCY_COPILOT_TRIAGE_LLM_COMMAND=

# Optional full response hook for standalone mode.
# The command receives the response prompt on stdin and prints a final reply on stdout.
PREGNANCY_COPILOT_RESPONSE_LLM_COMMAND=
